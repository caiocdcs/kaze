{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "cargo",
    "nix",
    "npm",
    "dockerfile",
    "docker-compose",
    "github-actions"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "gitAuthor": "Caio Silva <caio@cdcs.dev>",
  "labels": [
    "renovate"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboardApproval": true,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Homelab policy: every update waits for approval and review",
      "matchManagers": [
        "cargo",
        "nix",
        "npm",
        "dockerfile",
        "docker-compose",
        "github-actions"
      ],
      "automerge": false
    },
    {
      "groupName": "cargo",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "groupName": "github actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "groupName": "docker images",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ]
    },
    {
      "description": "Any pnpm-lock.yaml change needs new pnpmDeps hashes in flake.nix (one per system)",
      "groupName": "web",
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "needs-pnpm-hash"
      ]
    },
    {
      "description": "Lockfile refreshes only for Cargo.lock and flake.lock, for the same reason",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "enabled": false
    }
  ]
}

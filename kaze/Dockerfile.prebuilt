# Use pre-built binary from cross-compilation
FROM debian:bookworm-slim AS runtime

# Install Chromium and dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libxshmfence1 \
    chromium \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r kaze && useradd -r -g kaze -d /home/kaze -s /sbin/nologin kaze

# Copy pre-built Linux binary (place it in kaze/binary/kaze before building)
COPY binary/kaze /usr/local/bin/kaze

RUN mkdir -p /usr/share/kaze /Manga /home/kaze && \
    chown -R kaze:kaze /usr/share/kaze /Manga /home/kaze && \
    chmod +x /usr/local/bin/kaze

ENV PORT=6531
ENV DATABASE_URL=sqlite:///usr/share/kaze/kaze.db
ENV DOWNLOAD_LOCATION=/Manga
ENV HOME=/home/kaze

EXPOSE 6531

USER kaze

CMD ["kaze"]
